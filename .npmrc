# Az npm 10.8 függőségfeloldója összeomlik („Cannot read properties of null (reading 'edgesOut')”)
# a vitest → vite 8 → @vitejs/devtools → vitest opcionális peer-körön. A projektnek egyik csomagja
# sem igényel automatikusan telepített peer-függőséget, ezért a régi (npm 6-os) peer-kezelést kérjük.
legacy-peer-deps=true
